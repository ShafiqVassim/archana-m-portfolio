---
import Sunflower from '../motifs/Sunflower.astro';
import LavenderFlower from '../motifs/LavenderFlower.astro';
import Sprig from '../motifs/Sprig.astro';
import Cat from '../motifs/Cat.astro';
import CatPeek from '../motifs/CatPeek.astro';
import { site } from '../../data/site';
---
<section class="hero" id="top">
  <div class="shell hero__grid">
    <div class="hero__copy">
      <p class="eyebrow"><span class="folio">Fol. 01</span>Opening balance</p>
      <h1 class="hero__title">
        <span class="line"><span>I <em class="t-red balance">balance<span class="beam" aria-hidden="true"></span></em> books.</span></span>
        <span class="line"><span>My cat <em class="t-lav pk-name" data-poke data-greet>Pakkuru<span class="story-peek" aria-hidden="true"><span class="story-peek__move"><span class="story-peek__rot"><CatPeek /></span></span></span><span class="pk-bubble story-bubble" aria-hidden="true">chief auditor. hi.</span></em> sits on them<span class="paw-stop" title="signed, Pakkuru"><span class="sr-only">.</span><svg class="paw paw--1" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><ellipse cx="12" cy="16" rx="5" ry="4.2"/><circle cx="6.4" cy="9.6" r="2.2"/><circle cx="9.9" cy="6.4" r="2.2"/><circle cx="14.1" cy="6.4" r="2.2"/><circle cx="17.6" cy="9.6" r="2.2"/></svg><svg class="paw paw--2" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><ellipse cx="12" cy="16" rx="5" ry="4.2"/><circle cx="6.4" cy="9.6" r="2.2"/><circle cx="9.9" cy="6.4" r="2.2"/><circle cx="14.1" cy="6.4" r="2.2"/><circle cx="17.6" cy="9.6" r="2.2"/></svg></span></span></span>
      </h1>
      <p class="note hero__aside" aria-hidden="true">↳ he calls it auditing.</p>
      <p class="hero__lede">Accountant in Coimbatore with 3+ years of making billing, cash, ledgers and payroll add up. Tally-fluent, GST-literate, and personally offended by an unreconciled ledger.</p>
      <div class="hero__ctas" id="hero-ctas">
        <a class="btn" href="#ledger" data-scroll data-magnetic><span class="btn__label">See the ledger</span></a>
        <a class="btn btn--ghost" href={site.resume} download="Archana-M-Resume.pdf" data-stamp><span class="btn__label">Download resume</span><span class="btn__stamp" aria-hidden="true">Approved</span></a>
      </div>
      <p class="note hero__note">↳ fully audited. by me, twice. Pakkuru supervised.</p>
    </div>

    <div class="collage" data-parallax>
      <div class="c c--sprig" style="--depth:6" aria-hidden="true"><Sprig /></div>
      <div class="c c--portrait" style="--depth:3;--drag-rot:-1deg" aria-hidden="true">
        {site.portrait ? (
          <div class="portrait portrait--photo"><img src={site.portrait} alt="" width="300" height="390" decoding="async" fetchpriority="high" /></div>
        ) : (
          <div class="portrait">
            <span class="portrait__label mono">Photo of Archana</span>
            <span class="portrait__hand"><span class="cap-long">calculator in one hand, handmade flower in the other. </span><span class="cap-miss"><span class="cap-red">photo missing:</span> Pakkuru got into every shot.</span></span>
          </div>
        )}
      </div>
      <div class="c c--sun" style="--depth:10" aria-hidden="true"><div class="sun-land"><Sunflower class="spin-slow" /></div></div>
      <div class="c c--lav" style="--depth:14" aria-hidden="true"><LavenderFlower /></div>
      <div class="c c--receipt" style="--depth:7;--drag-rot:5deg" aria-hidden="true">
        <div class="receipt mono">
          <b>Opening balance</b>
          <span class="rule"></span>
          <span>Experience <i></i> 3+ yrs</span>
          <span>Employers <i></i> 3</span>
          <span>Tally <i></i> fluent</span>
          <span class="receipt__long">Unreconciled <i></i> <em>not on my watch</em></span>
          <span class="rule"></span>
          <b>Status <i></i> hireable</b>
          <span class="receipt__stamp" aria-hidden="true">Audited by: Pakkuru</span>
        </div>
      </div>
      <div class="c c--cat" style="--depth:9;--drag-rot:0deg" data-cat-piece aria-hidden="true"><Cat /></div>
      <div class="c c--sticker" style="--depth:12;--drag-rot:-3deg" aria-hidden="true">
        <span class="sticker__play">▶</span><span class="sticker__k mono">Now playing</span><span class="sticker__v">{site.song.title}<span class="hide-xs">, on loop</span></span>
      </div>
      <div class="drag-ui">
        <span class="drag-hint" aria-hidden="true">↳ go on, rearrange my desk. Pakkuru will complain.</span>
        <button class="tidy" type="button" data-tidy>Tidy up ↺</button>
      </div>
    </div>
    <div class="drag-ui drag-ui--m">
      <span class="drag-hint" aria-hidden="true">↳ go on, rearrange my desk. Pakkuru will complain.</span>
      <button class="tidy" type="button" data-tidy>Tidy up ↺</button>
    </div>
  </div>
</section>

<style>
  .hero { position: relative; padding-top: clamp(104px, 10vw, 148px); padding-bottom: clamp(56px, 7.8vw, 112px); background-image: repeating-linear-gradient(to bottom, transparent 0 31px, rgb(157 184 211 / .22) 31px 32px); overflow: clip; }
  .hero__grid { display: grid; grid-template-columns: minmax(0, 700fr) minmax(0, 400fr); gap: clamp(32px, 4.2vw, 60px); align-items: center; }
  .hero__title { margin-top: 22px; font: 400 clamp(46px, 5.84vw, 84px)/0.98 var(--f-display); letter-spacing: -0.035em; max-width: 9.6em; }
  .hero__title em { font-style: italic; }
  .t-red { color: var(--red); } .t-lav { color: var(--dlav); }
  .line { display: block; overflow: visible; padding-bottom: .16em; margin-bottom: -.16em; }
  :global(html.motion-ok:not(.splash-on)) .line:not(:global(.done)) { overflow: clip; }
  .balance { position: relative; display: inline-block; }
  .beam { position: absolute; left: 6%; right: 6%; bottom: -.02em; height: .045em; min-height: 3px; border-radius: 3px; background: var(--red); transform-origin: 50% 50%; }
  .beam::after { content: ''; position: absolute; left: 50%; top: 100%; width: .16em; height: .1em; translate: -50% 0; background: var(--red); clip-path: polygon(50% 0, 100% 100%, 0 100%); }
  :global(html.motion-ok) .beam { animation: weigh 1.8s var(--ease-out) calc(var(--intro, .15s) + .5s) both; }
  .balance { transform-origin: 50% 92%; }
  :global(html.motion-ok) .balance { animation: rock 5.5s ease-in-out calc(var(--intro, .15s) + 2.3s) infinite; }
  @keyframes rock { 0%, 100% { transform: rotate(0); } 25% { transform: rotate(-2.2deg); } 75% { transform: rotate(2.2deg); } }
  .balance:hover .beam { animation: weigh 1.4s var(--ease-out) both; }
  @keyframes weigh { 0% { transform: rotate(-7deg); } 30% { transform: rotate(5deg); } 55% { transform: rotate(-2.5deg); } 78% { transform: rotate(1deg); } 100% { transform: rotate(0); } }
  /* full stop = two golden paw prints that step in, like the paw trail below */
  .paw-stop { font-size: max(1em, 62px); position: relative; display: inline-block; width: .6em; height: .5em; margin-left: .03em; vertical-align: 0; color: #DE9A35; }
  .paw { position: absolute; width: .3em; height: .3em; fill: currentColor; }
  .paw--1 { left: 0; bottom: -.02em; transform: rotate(-24deg); }
  .paw--2 { left: .29em; bottom: .17em; transform: rotate(-6deg); }
  :global(html.motion-ok) .paw { opacity: 0; animation: paw-step 6s var(--ease-out) infinite; }
  :global(html.motion-ok) .paw--1 { animation-delay: calc(var(--intro, .15s) + 1.1s); }
  :global(html.motion-ok) .paw--2 { animation-delay: calc(var(--intro, .15s) + 1.5s); }
  @keyframes paw-step { 0% { opacity: 0; scale: 1.5; } 5% { opacity: 1; scale: .92; } 9%, 74% { opacity: 1; scale: 1; } 86%, 100% { opacity: 0; scale: 1; } }
  @keyframes paw-stamp-unused { 0% { opacity: 0; transform: rotate(-30deg) scale(2.2); } 60% { opacity: 1; transform: rotate(-8deg) scale(.9); } 100% { transform: rotate(-12deg) scale(1); } }
  .keep { white-space: nowrap; }
  .o-flower { display: inline-block; width: .6em; height: .6em; margin: 0 -.05em 0 0; vertical-align: -.06em; }
  .o-flower svg { width: 100%; height: 100%; display: block; }
  :global(html.motion-ok) .o-flower svg { animation: bloom-o 1.2s var(--ease-spring) calc(var(--intro, .15s) + .3s) both; }
  .hero__title:hover .o-flower svg { animation: spin-o 1.2s var(--ease-out); }
  @keyframes bloom-o { from { transform: scale(0) rotate(-120deg); } }
  @keyframes spin-o { to { transform: rotate(360deg); } }
  .line > span { display: block; }
  .hero__lede { margin-top: 26px; max-width: 32em; color: var(--muted); font-size: clamp(17px, 1.4vw, 20px); }
  .pk-name { position: relative; z-index: 3; display: inline-block; cursor: pointer; }
  .story-peek { font-size: max(1em, 64px); position: absolute; left: calc(50% - .4em); bottom: calc(100% - .12em); width: .8em; height: .6em; overflow: hidden; pointer-events: none; }
  .story-peek__move { position: absolute; inset: 0; transform: translateY(0); }
  .story-peek__rot { position: absolute; left: .13em; top: -.1em; width: .54em; height: .77em; transform: rotate(-90deg); }
  .story-peek__move { transform: translateY(125%); transition: transform .45s var(--ease-spring); }
  .story-peek, .story-bubble { z-index: 4; }
  .line:has(.pk-name) { position: relative; z-index: 2; }
  .hero__aside { margin-top: 2px; font-size: clamp(20px, 1.8vw, 24px); }
  @media (max-width: 1100px) { .hero__aside { margin-top: -16px; } }
  .story-peek__rot :global(svg) { width: 100%; height: 100%; display: block; }
  .pk-name:hover .story-peek__move, .pk-name:global(.is-talking) .story-peek__move { animation: none; transform: none; }
  @media (hover: hover) { .pk-name:hover .story-bubble { opacity: 1; transform: none; } }
  .story-bubble { font-size: 19px; letter-spacing: normal; font-style: normal; left: calc(50% + 34px); bottom: calc(100% + 10px); transform-origin: 0% 100%; }
  @media (max-width: 860px) { .story-bubble { font-size: 16px; left: auto; right: calc(50% + 30px); bottom: calc(100% + 8px); top: auto; transform-origin: 100% 100%; } .hero__title { margin-bottom: 0; } }
  .hero__ctas { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 30px; }
  .hero__note { margin-top: 26px; }

  /* Collage — positions mirror the Figma frame (400×600) */
  .collage { position: relative; width: 100%; max-width: 400px; aspect-ratio: 400 / 600; justify-self: end; --mx: 0; --my: 0; }
  .c { position: absolute; transform: translate3d(calc(var(--mx) * var(--depth) * 1px + var(--dx, 0px)), calc(var(--my) * var(--depth) * 1px + var(--dy, 0px)), 0) rotate(var(--rot, 0deg)); transition: transform .6s var(--ease-out); }
  .c { -webkit-touch-callout: none; -webkit-user-select: none; user-select: none; touch-action: none; }
  .c.is-pressing { scale: 1.04; transition: transform .6s var(--ease-out), scale .28s var(--ease-out); }
  .c.is-dragging { cursor: grabbing; transition: none; scale: 1.04; --rot: var(--drag-rot, 0deg); filter: drop-shadow(0 18px 22px rgb(31 36 51 / .18)); }
  @media (pointer: fine) { .c { cursor: grab; touch-action: none; } }
  .c.is-returning { transition: transform .8s var(--ease-spring); }
  .drag-ui { position: absolute; left: 0; right: 0; top: calc(100% + 18px); display: none; align-items: center; justify-content: space-between; gap: 12px; }
  @media (min-width: 861px) { .drag-ui { display: flex; } }
  .drag-ui--m { display: none; }
  .drag-hint { font: 400 22px/1.1 var(--f-hand); color: var(--red); opacity: 0; transform: translateY(4px); transition: opacity .3s, transform .35s var(--ease-out); }
  .hero:global(.is-arranging) .drag-hint, .hero:global(.is-arranged) .drag-hint { opacity: 1; transform: none; }
  @media (hover: hover) { .collage:hover .drag-hint { opacity: 1; transform: none; } }
  .tidy { display: inline-flex; flex-shrink: 0; white-space: nowrap; align-items: center; gap: 6px; min-height: 36px; padding: 6px 14px; border: 1px solid var(--ink); border-radius: 999px; font: 500 13px/1 var(--f-body); background: var(--paper); opacity: 0; transform: translateY(6px); pointer-events: none; transition: opacity .3s, transform .4s var(--ease-spring), background-color .25s, color .25s; }
  .tidy:not(.is-on) { display: none; }
  .tidy.is-on { opacity: 1; transform: none; pointer-events: auto; animation: tidy-in .45s var(--ease-spring); }
  @keyframes tidy-in { from { opacity: 0; transform: translateY(6px) scale(.9); } }
  .tidy:hover { background: var(--ink); color: var(--paper); }
  .c--sprig { left: -1.5%; top: 18%; width: 22.5%; }
  .c--portrait { left: 17.5%; top: 3.3%; width: 75%; --rot: -3deg; }
  .c--sun { left: -12.5%; top: 50%; width: 55%; z-index: 2; }
  .c--lav { left: 79.5%; top: -2.7%; width: 27.5%; z-index: 3; }
  .c--receipt { left: 41%; top: 60%; width: 57%; z-index: 3; --rot: 2deg; }
  .c--sticker { left: 0; top: 0; z-index: 4; --rot: 4deg; }
  .c--cat { left: 73%; top: 41%; width: 24%; z-index: 4; }
  .c--cat :global(.cat__bubble) { left: auto !important; right: 72%; transform-origin: 100% 100%; }
  .c--cat.is-returning { transition-delay: .18s; }
  .portrait { aspect-ratio: 300 / 390; border-radius: 12px; border: 1px solid var(--line); padding: 38% 10% 0 22%; display: grid; align-content: start; gap: 8px; background: var(--paper) repeating-linear-gradient(to bottom, transparent 0 27px, rgb(157 184 211 / .6) 27px 28px); position: relative; }
  .portrait::before { content: ''; position: absolute; top: 0; bottom: 0; left: 12%; border-left: 1.5px solid rgb(179 38 30 / .8); }
  .portrait--photo { padding: 0; overflow: hidden; }
  .portrait--photo img { width: 100%; height: 100%; object-fit: cover; }
  .portrait--photo::before { display: none; }
  .portrait__label { font-size: 11px; letter-spacing: .1em; text-transform: uppercase; color: var(--muted); }
  .portrait__hand { font: 400 clamp(19px, 1.7vw, 24px)/1.05 var(--f-hand); }
  .cap-miss { display: block; margin-top: .35em; }
  .cap-red { color: var(--red); }
  .receipt { display: grid; gap: 4px; padding: clamp(12px, 1.25vw, 18px) clamp(12px, 1.25vw, 18px) 22px; background: #fff; font-size: clamp(10px, .84vw, 12px); line-height: 1.5; box-shadow: 0 10px 28px rgb(31 36 51 / .12); -webkit-mask: radial-gradient(circle 5px at 50% 100%, #0000 98%, #000) 0 0 / 14px 100%; mask: radial-gradient(circle 5px at 50% 100%, #0000 98%, #000) 0 0 / 14px 100%; }
  .receipt b { font-weight: 500; text-transform: uppercase; letter-spacing: .06em; display: flex; }
  .receipt span { display: flex; align-items: baseline; white-space: nowrap; min-width: 0; }
  .receipt i { flex: 1; border-bottom: 1px dotted #9a9384; margin: 0 6px; min-width: 12px; transform: translateY(-3px); }
  .receipt em { font-style: normal; white-space: normal; text-align: right; flex: 0 1 auto; min-width: 0; }
  .receipt__long { align-items: flex-end !important; }
  .receipt .rule { border-top: 1px dashed #b9b2a3; margin: 4px 0; }
  .receipt { position: relative; }
  .receipt__stamp { position: absolute; left: 10%; bottom: 16%; padding: 3px 8px; border: 1.5px solid var(--red); border-radius: 4px; color: var(--red); font: 500 10px/1.2 var(--f-mono); letter-spacing: .1em; text-transform: uppercase; white-space: nowrap; opacity: 0; transform: rotate(-8deg) scale(1.6); pointer-events: none; }
  .receipt.is-audited .receipt__stamp { animation: audit-stamp 2.2s var(--ease-out) forwards; }
  @keyframes audit-stamp { 0% { opacity: 0; transform: rotate(-8deg) scale(1.6); } 14% { opacity: .92; transform: rotate(-8deg) scale(.96); } 20% { transform: rotate(-8deg) scale(1); } 85% { opacity: .92; } 100% { opacity: 0; transform: rotate(-8deg) scale(1); } }
  @media (min-width: 861px) and (max-width: 1100px) { .receipt { font-size: 9.5px; padding: 11px 10px 18px; } .receipt i { margin: 0 4px; min-width: 6px; } }
  .c--sticker { display: inline-flex; align-items: center; gap: 8px; padding: 9px 16px 9px 10px; border-radius: 999px; background: var(--sun); color: var(--ink); text-decoration: none; font-size: 13px; white-space: nowrap; box-shadow: 0 6px 16px rgb(181 130 26 / .25); }
  .c--sticker:hover { --rot: -2deg; }
  .sticker__play { display: grid; place-items: center; width: 24px; height: 24px; border-radius: 50%; background: var(--ink); color: var(--sun); font-size: 10px; transition: transform .4s var(--ease-spring); }
  .c--sticker:hover .sticker__play { transform: scale(1.15); }
  .sticker__k { font-size: 11px; font-weight: 500; letter-spacing: .08em; text-transform: uppercase; }

  /* Orchestrated intro: lines rise, collage settles, sunflower lands */
  :global(html.motion-ok:not(.splash-on)) .line > span { animation: line-up .8s var(--ease-out) both; }
  :global(html.motion-ok:not(.splash-on)) .line + .line > span { animation-delay: .08s; }
  :global(html.motion-ok) .c { animation: settle .9s var(--ease-out) both; animation-delay: calc(var(--intro, .15s) + .25s); }
  :global(html.motion-ok) .sun-land { animation: land 1.1s var(--ease-spring) calc(var(--intro, .15s) + .05s) both; }
  :global(html.splash-on) { --intro: 1.8s; }
  @keyframes line-up { from { transform: translateY(105%); } }
  @keyframes settle { from { opacity: 0; translate: 0 18px; } }
  @keyframes land { from { transform: translate(40%, -70%) scale(1.5) rotate(-40deg); opacity: 0; } 60% { opacity: 1; } }
  :global(html.motion-ok) :global(.spin-slow) { animation: spin 80s linear infinite; }
  @keyframes spin { to { transform: rotate(360deg); } }

  @media (max-width: 860px) {
    .hero__grid { grid-template-columns: 1fr; }
    .receipt__long { flex-wrap: wrap; row-gap: 1px; }
    .receipt__long em { flex-basis: 100%; }
    .collage { order: 0; max-width: 420px; aspect-ratio: 350 / 330; justify-self: center; margin-top: 8px; }
    .hero__copy { display: contents; }
    .hero__copy > .eyebrow { order: -3; } .hero__title { order: -2; margin-top: 0; }
    .hero__lede { order: 1; margin-top: 0; }
    .hero__ctas { order: 2; margin-top: 4px; } .hero__note { order: 6; margin-top: 0; }
    .hero__grid { gap: 22px; }
    .hero__ctas .btn { flex: 1 1 100%; }
    .drag-ui--m { order: 0; display: none; flex-wrap: wrap; row-gap: 10px; position: static; margin-top: -6px; }
    .hero:global(.is-arranging) .drag-ui--m, .hero:global(.is-arranged) .drag-ui--m { display: flex; }
    .drag-ui--m .drag-hint { flex: 1 1 100%; }
    .drag-ui--m .drag-hint { font-size: 20px; }
    .c--sprig { left: 12%; top: 11%; width: 16%; }
    .c--portrait { left: 27%; top: 8%; width: 51%; }
    .c--sun { left: 2%; top: 48%; width: 37%; }
    .c--lav { left: 83%; top: 4%; width: 16.5%; }
    .c--receipt { left: 53%; top: 41%; width: 46%; }
    .c--sticker { left: 6%; top: -2%; }
    .c--cat { left: 81%; top: 21%; width: 17%; }
    .portrait__hand { font-size: 16px; }
    /* the receipt covers the lower half of the card on phones: lift the label, keep only the punchline */
    .portrait { padding-top: 3%; gap: 2px; padding-right: 6%; }
    .portrait .portrait__hand { font-size: 15px; line-height: .96; }
    .cap-long { display: none; }
    .cap-miss { margin-top: 0; }
    .receipt { font-size: 10px; padding: 12px 12px 16px; }
    .receipt__stamp { left: 5%; font-size: 8px; letter-spacing: .04em; padding: 2px 5px; }
  }
  @media (max-width: 420px) {
    .hero__title { font-size: 11.2vw; }
    .hide-xs { display: none; }
    .receipt { font-size: 2.45vw; padding: 10px 9px 14px; }
    .c--sticker { font-size: 12px; gap: 6px; padding: 7px 12px 7px 8px; }
  }
</style>
