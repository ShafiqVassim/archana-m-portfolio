---
import { site } from '../../data/site';
---
<div class="sticky" id="sticky" aria-hidden="true" inert>
  <a class="btn btn--sun sticky__main" href={`mailto:${site.email}`} data-email><span class="btn__label">Email Archana</span></a>
  <a class="btn btn--ghost" href={site.resume} download="Archana-M-Resume.pdf" data-stamp><span class="btn__label">Résumé ↓</span><span class="btn__stamp" aria-hidden="true">Approved</span></a>
</div>
<style>
  .sticky { display: none; }
  @media (max-width: 640px) {
    .sticky { position: fixed; inset: auto 0 0; z-index: 45; display: flex; gap: 10px; padding: 12px 16px calc(12px + env(safe-area-inset-bottom)); background: rgb(255 253 248 / .92); -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px); border-top: 1px solid var(--line); transform: translateY(110%); transition: transform .5s var(--ease-spring); }
    .sticky.is-on { transform: none; }
    .sticky__main { flex: 1; }
  }
</style>
