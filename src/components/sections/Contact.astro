---
import Mandala from '../motifs/Mandala.astro';
import CatNight from '../motifs/CatNight.astro';
import { site } from '../../data/site';
---
<section class="contact on-ink" id="contact" aria-labelledby="contact-title">
  <div class="contact__motif" aria-hidden="true" data-scroll-spin="-0.04"><Mandala color="#FFFDF8" /></div>
  <div class="shell">
    <p class="eyebrow"><span class="folio">Fol. 06</span>Closing balance</p>
    <h2 class="contact__title" id="contact-title" data-anim>Let’s reconcile.</h2>
    <p class="contact__lede" data-anim style="--d:.08s">Looking for an accountant who reads the fine print and still has a sense of humour? The ledger is open.</p>
    <dl class="details" data-anim style="--d:.14s">
      <div><dt class="mono">Email</dt><dd><a href={`mailto:${site.email}`} data-email>{site.email}</a></dd></div>
      <div><dt class="mono">LinkedIn</dt><dd><a href={site.linkedin} target="_blank" rel="noopener">{site.name}<span class="ext" aria-hidden="true"> ↗</span><span class="sr-only"> (opens in a new tab)</span></a></dd></div>
      <div><dt class="mono">Based in</dt><dd>{site.location}</dd></div>
    </dl>
    <div class="contact__ctas" data-anim style="--d:.2s">
      <a class="btn btn--sun" href={`mailto:${site.email}`} data-email data-magnetic><span class="btn__label">Email Archana</span></a>
      <a class="btn btn--ghost-light" href={site.resume} download="Archana-M-Resume.pdf" data-stamp><span class="btn__label">Download resume</span><span class="btn__stamp" aria-hidden="true">Approved</span></a>
    </div>
    <div class="total" data-reveal>
      <span class="mono total__k">Closing balance</span>
      <span class="total__dots" aria-hidden="true"></span>
      <span class="mono total__v">1 good hire</span>
      <span class="night" data-poke data-greet aria-hidden="true"><CatNight /><span class="pk-bubble night-bubble">still watching. hire her.</span></span>
    </div>
    <footer class="foot mono">
      <span>© {new Date().getFullYear()} {site.name} · Balanced since 2022 · Pakkuru-approved</span>
      <span class="foot__end"><button type="button" class="pk-toggle" data-follow-toggle aria-pressed="true" hidden>Pakkuru: following ✓</button><a href="#top" data-scroll>Back to opening balance ↑</a></span>
    </footer>
  </div>
</section>

<style>
  .contact { position: relative; overflow: hidden; background: var(--ink); color: var(--paper); padding-top: var(--section-y); padding-bottom: calc(48px + env(safe-area-inset-bottom)); margin-top: var(--section-y); }
  .contact .eyebrow { color: var(--sun); }
  .contact__motif { position: absolute; right: max(-60px, calc((100vw - 1440px) / 2 + 40px)); top: 60px; width: clamp(240px, 30vw, 440px); opacity: .12; pointer-events: none; }
  .contact__title { margin-top: 20px; font: 400 clamp(60px, 9.45vw, 136px)/0.95 var(--f-display); letter-spacing: -0.035em; }
  .contact__lede { margin-top: 24px; max-width: 32em; font-size: clamp(16px, 1.45vw, 21px); color: rgb(255 253 248 / .82); }
  .details { display: grid; grid-template-columns: 1.4fr 1fr 1fr; gap: 20px; margin-top: 48px; }
  .details dt { font-size: 12px; font-weight: 500; letter-spacing: .1em; text-transform: uppercase; color: var(--sun); }
  .details dd { margin-top: 8px; font: 400 clamp(20px, 1.7vw, 24px)/1.3 var(--f-display); overflow-wrap: anywhere; }
  .details a { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 4px; text-decoration-color: rgb(255 253 248 / .4); transition: text-decoration-color .25s; }
  .details a:hover { text-decoration-color: var(--sun); }
  .ext { font-family: var(--f-body); }
  .contact__ctas { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 40px; }
  .total { position: relative; display: flex; align-items: center; gap: 16px; margin-top: 56px; padding: 24px 0; border-block: 1px dashed rgb(255 253 248 / .3); }
  .total__k, .total__v { font-size: 15px; font-weight: 500; letter-spacing: .1em; text-transform: uppercase; white-space: nowrap; }
  .total__v { color: var(--sun); }
  .night { position: absolute; left: 66%; top: -91px; width: 96px; cursor: pointer; -webkit-tap-highlight-color: transparent; }
  .night :global(svg) { display: block; width: 100%; }
  .night-bubble { left: 70%; top: -26px; }
  .night :global(.night-eye) { transform-box: fill-box; transform-origin: center; transition: transform .3s var(--ease-spring); }
  :global(html.motion-ok) .night :global(.night-eye) { animation: nblink 6s infinite; }
  @keyframes nblink { 0%, 93%, 100% { transform: scaleY(1); } 96% { transform: scaleY(.1); } }
  .night :global(.night-tail) { transform-box: fill-box; transform-origin: 0% 0%; }
  :global(html.motion-ok) .night :global(.night-tail) { animation: nsway 4s ease-in-out infinite; }
  @keyframes nsway { 50% { transform: rotate(7deg); } }
  @media (hover: hover) { .night:hover :global(.night-eye) { animation: none; transform: scale(1.25); } }
  .night:global(.is-poked) :global(.night-eye) { animation: none; transform: scale(1.25); }
  .total__dots { flex: 1; height: 2px; background: radial-gradient(circle, rgb(255 253 248 / .45) 1px, transparent 1.5px) 0 50% / 8px 2px repeat-x; transform-origin: left; }
  :global(html.motion-ok) .total__dots { transform: scaleX(0); }
  :global(html.motion-ok) .total__v { opacity: 0; }
  .total:global(.is-in) .total__dots { animation: grow 1.2s var(--ease-out) .1s forwards; }
  .total:global(.is-in) .total__v { animation: stamp-in .55s var(--ease-spring) 1.1s forwards; }
  @keyframes grow { to { transform: scaleX(1); } }
  @keyframes stamp-in { from { opacity: 0; transform: scale(1.8) rotate(-8deg); } to { opacity: 1; transform: rotate(-2deg); } }
  .foot { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 12px; margin-top: 40px; font-size: 12px; color: rgb(255 253 248 / .6); }
  .foot a { text-decoration: none; } .foot a:hover { color: var(--sun); }
  .foot__end { display: inline-flex; gap: 20px; flex-wrap: wrap; }
  .pk-toggle { font: inherit; color: inherit; background: none; border: 0; padding: 0; cursor: pointer; }
  .pk-toggle:hover { color: var(--sun); }
  .pk-toggle[aria-pressed='false'] { opacity: .7; }
  @media (max-width: 860px) {
    .details { grid-template-columns: 1fr; gap: 22px; margin-top: 36px; }
    .details dd { font-size: 19px; overflow-wrap: normal; }
    .details a[data-email] { font-size: clamp(16px, 4.9vw, 19px); }
    .contact__ctas .btn { flex: 1 1 100%; }
    .total__k, .total__v { font-size: 12px; }
    .total { margin-top: 112px; }
    .night { left: calc(50% - 36px); top: -68px; width: 72px; }
    .night-bubble { left: 50%; translate: -50% 0; top: -34px; font-size: 17px; transform-origin: 50% 100%; }
    .contact { padding-bottom: calc(96px + env(safe-area-inset-bottom)); }
  }
</style>
