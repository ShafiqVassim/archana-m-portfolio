---
import { nav } from '../../data/site';
const items = [{ id: 'top', index: 'Opening balance' }, ...nav];
---
<dialog class="contents" id="contents" aria-labelledby="contents-title">
  <div class="contents__head">
    <p class="contents__title" id="contents-title">Contents</p>
    <button class="contents__close" type="button" data-close-contents aria-label="Close contents">×</button>
  </div>
  <ol>
    {items.map((it, i) => (
      <li><a href={`#${it.id}`} data-scroll data-close-contents><span>{it.index}</span><i aria-hidden="true"></i><span class="mono">{String(i + 1).padStart(2, '0')}</span></a></li>
    ))}
  </ol>
  <p class="note">↳ everything balances. we checked.</p>
</dialog>
<style>
  .contents { width: min(420px, calc(100vw - 24px)); max-height: calc(100dvh - 24px); margin: 12px 12px auto auto; padding: 24px; border: 1px solid var(--line); border-radius: 20px; background: var(--paper); color: var(--ink); box-shadow: 0 24px 48px rgb(31 36 51 / .2); }
  .contents[open] { animation: drop .45s var(--ease-spring); }
  .contents::backdrop { background: rgb(31 36 51 / .35); -webkit-backdrop-filter: blur(2px); backdrop-filter: blur(2px); }
  @keyframes drop { from { opacity: 0; transform: translateY(-12px) scale(.97); } }
  .contents__head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px; }
  .contents__title { font: 400 34px/1 var(--f-display); letter-spacing: -0.02em; }
  .contents__close { width: 44px; height: 44px; border-radius: 50%; border: 1px solid var(--ink); font-size: 24px; line-height: 1; }
  ol a { display: flex; align-items: baseline; gap: 10px; min-height: 48px; padding: 12px 0; text-decoration: none; font: 500 18px/1.2 var(--f-body); }
  ol i { flex: 1; border-bottom: 1px dotted var(--muted); transform: translateY(-4px); }
  ol .mono { color: var(--red); font-size: 13px; }
  ol a:hover span:first-child { color: var(--dlav); }
  .note { margin-top: 12px; }
</style>
