  <path d="M57 49 L63 51 M59 58.5 L65 58.5 M57 68 L63 66" stroke="#B9701F" stroke-width="2.2" stroke-linecap="round"/>
  <path d="M60.83 58.5L26.51 51.48V65.52Z" fill="#FFF4E0"/>
  <ellipse cx="21.05" cy="58.5" rx="11.7" ry="19.5" fill="#FFF4E0"/>
