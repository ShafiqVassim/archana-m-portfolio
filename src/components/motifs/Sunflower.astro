---
// Crochet sunflower — same geometry as Figma "Motif / Crochet sunflower" (200×200).
// Default render is a <use> of the sprite (keeps the DOM small); `inline` draws every petal (needed for the splash bloom).
interface Props { class?: string; inline?: boolean; symbol?: boolean }
const { class: cls = '', inline = false, symbol = false } = Astro.props;
const r = (n: number) => Math.round(n * 100) / 100;
const petals = Array.from({ length: 18 }, (_, i) => ({ i, deg: r((i * 360) / 18) }));
const seeds = [
  ...Array.from({ length: 10 }, (_, i) => [100 + Math.cos((i * Math.PI) / 5) * 27, 100 + Math.sin((i * Math.PI) / 5) * 27]),
  ...Array.from({ length: 6 }, (_, i) => [100 + Math.cos((i * Math.PI) / 3 + 0.3) * 13, 100 + Math.sin((i * Math.PI) / 3 + 0.3) * 13]),
].map(([x, y]) => [r(x), r(y)]);
const body = !inline && !symbol ? null : true;
---
{symbol ? (
  <symbol id="m-sunflower" viewBox="0 0 200 200">
    <g fill="#F5B82E" stroke="#B5821A" stroke-width="1.2" stroke-dasharray="2 3">
      {petals.map((p) => <ellipse cx="167" cy="100" rx="31" ry="13.5" transform={`rotate(${p.deg} 100 100)`} />)}
    </g>
    <circle cx="100" cy="100" r="46" fill="#6B4423" stroke="#9C6B3A" stroke-width="1.2" stroke-dasharray="2 3" />
    <g fill="#D9A441">{seeds.map(([x, y]) => <circle cx={x} cy={y} r="2.5" />)}</g>
  </symbol>
) : inline ? (
  <svg class={`motif sunflower ${cls}`} viewBox="0 0 200 200" aria-hidden="true" focusable="false">
    <g class="sunflower__petals">
      {petals.map((p) => (
        <g transform={`rotate(${p.deg} 100 100)`}>
          <ellipse class="petal" style={`--i:${p.i}`} cx="167" cy="100" rx="31" ry="13.5" fill="#F5B82E" stroke="#B5821A" stroke-width="1.2" stroke-dasharray="2 3" />
        </g>
      ))}
    </g>
    <g class="sunflower__disc">
      <circle cx="100" cy="100" r="46" fill="#6B4423" stroke="#9C6B3A" stroke-width="1.2" stroke-dasharray="2 3" />
      {seeds.map(([x, y]) => <circle cx={x} cy={y} r="2.5" fill="#D9A441" />)}
    </g>
  </svg>
) : (
  <svg class={`motif sunflower ${cls}`} viewBox="0 0 200 200" aria-hidden="true" focusable="false"><use href="#m-sunflower" /></svg>
)}
