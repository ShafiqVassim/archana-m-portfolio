---
// Pakkuru — golden crochet tabby (Figma "Motif / Pakkuru"). One SVG, five states:
// idle · petted · dragging · dropped · audited. Groups opt in to states via data-s (space-separated).
interface Props { class?: string; mini?: boolean }
const { class: cls = '', mini = false } = Astro.props;
const fur = '#DE9A35', stitch = '#A8641C', stripe = '#B9701F', cream = '#FFF4E0', dark = '#3A2717', white = '#FFFDF8',
  rose = '#E9A3B5', lav = '#B9A6E0', lavS = '#7E6AAE', sun = '#F5B82E', sunS = '#B5821A', seed = '#6B4423', dlav = '#5E4B8B';
const st = { fill: fur, stroke: stitch, 'stroke-width': 1.2, 'stroke-dasharray': '2 3' };
---
<span class={`cat ${mini ? 'cat--mini' : ''} ${cls}`} data-state="idle" aria-hidden="true">
  <svg viewBox="0 0 180 240" focusable="false">
    <g class="cat__sit" data-s="idle petted dropped audited">
      <path data-s="idle audited" d="M132 214 C172 206 172 168 152 156" fill="none" stroke={fur} stroke-width="12" stroke-linecap="round" />
      <path data-s="petted" d="M134 212 C166 196 172 150 152 132" fill="none" stroke={fur} stroke-width="12" stroke-linecap="round" />
      <path data-s="dropped" class="cat__tail-flick" d="M134 212 C172 196 148 160 172 136" fill="none" stroke={fur} stroke-width="12" stroke-linecap="round" />
      <g class="cat__breath">
        <ellipse cx="90" cy="180" rx="50" ry="45" {...st} />
        <ellipse cx="90" cy="184" rx="22" ry="26" fill={cream} />
        <g>
          <ellipse cx="71" cy="221" rx="13" ry="7.5" fill={cream} stroke={stitch} stroke-width="1.3" />
          <ellipse cx="109" cy="221" rx="13" ry="7.5" fill={cream} stroke={stitch} stroke-width="1.3" />
          <path d="M67 216.5 L67 221 M75 216.5 L75 221 M105 216.5 L105 221 M113 216.5 L113 221" stroke={stitch} stroke-width="1.2" stroke-linecap="round" />
        </g>
        <rect x="62" y="146" width="56" height="8" rx="4" fill={lav} stroke={lavS} />
        <circle cx="90" cy="157" r="6" fill={sun} stroke={sunS} /><circle cx="90" cy="157" r="2.5" fill={seed} />
        <path d="M50 100 L56 56 L84 84 Z M130 100 L124 56 L96 84 Z" fill={fur} />
        <path d="M57 90 L60 68 L74 84 Z M123 90 L120 68 L106 84 Z" fill={rose} />
        <ellipse cx="90" cy="110" rx="46" ry="40" {...st} />
        <path d="M78 78 L82 86 M102 78 L98 86 M72 83 L77 90 M108 83 L103 90" stroke={stripe} stroke-width="2.6" stroke-linecap="round" />
        <path d="M90 78 L82 120 L98 120 Z" fill={cream} />
        <ellipse cx="90" cy="128" rx="24" ry="16" fill={cream} />
        <path d="M85 120 L95 120 L90 126 Z" fill={rose} />
        <path d="M66 126 L40 120 M66 132 L40 135 M114 126 L140 120 M114 132 L140 135" stroke={dark} stroke-opacity=".45" stroke-width="1.2" />
        <g data-s="idle audited" fill="none" stroke-linecap="round">
          <path d="M60 106 C64 112 72 112 76 106 M104 106 C108 112 116 112 120 106" stroke={dark} stroke-width="2.8" />
          <path d="M60 99 C65 97 70 97 75 99 M105 96 C110 93 115 93 120 95" stroke={dark} stroke-width="1.6" />
          <path d="M82 130 C85 134 89 134 90 130 C91 134 95 134 98 130" stroke={dark} stroke-width="1.5" />
        </g>
        <g data-s="petted">
          <path d="M60 108 C64 101 72 101 76 108 M104 108 C108 101 116 101 120 108" fill="none" stroke={dark} stroke-width="2.8" stroke-linecap="round" />
          <ellipse cx="53.5" cy="118" rx="7.5" ry="4" fill={rose} opacity=".9" /><ellipse cx="126.5" cy="118" rx="7.5" ry="4" fill={rose} opacity=".9" />
          <path d="M83 129 C85 138 95 138 97 129 Z" fill={dark} />
        </g>
        <g data-s="dropped">
          <path d="M59 105 L77 109 M121 105 L103 109" stroke={dark} stroke-width="2.8" stroke-linecap="round" />
          <circle cx="69" cy="113" r="3" fill={dark} /><circle cx="111" cy="113" r="3" fill={dark} />
          <path d="M84 131 L96 131" stroke={dark} stroke-width="1.6" stroke-linecap="round" />
        </g>
      </g>
    </g>
    <g class="cat__drag" data-s="dragging">
      <path d="M106 196 C116 214 100 226 110 238" fill="none" stroke={fur} stroke-width="11" stroke-linecap="round" />
      <ellipse cx="68.5" cy="205" rx="8.5" ry="17" fill={fur} /><ellipse cx="111.5" cy="205" rx="8.5" ry="17" fill={fur} />
      <ellipse cx="68.5" cy="218.5" rx="8" ry="5.5" fill={cream} stroke={stitch} stroke-width="1.2" /><ellipse cx="111.5" cy="218.5" rx="8" ry="5.5" fill={cream} stroke={stitch} stroke-width="1.2" />
      <g fill={rose}><circle cx="68.5" cy="220" r="2.2" /><circle cx="64.5" cy="216.5" r="1.3" /><circle cx="68.5" cy="215.3" r="1.3" /><circle cx="72.5" cy="216.5" r="1.3" /><circle cx="111.5" cy="220" r="2.2" /><circle cx="107.5" cy="216.5" r="1.3" /><circle cx="111.5" cy="215.3" r="1.3" /><circle cx="115.5" cy="216.5" r="1.3" /></g>
      <ellipse cx="90" cy="154" rx="43" ry="58" {...st} />
      <ellipse cx="90" cy="147" rx="20" ry="31" fill={cream} />
      <ellipse cx="60" cy="143" rx="8" ry="19" fill={fur} /><ellipse cx="120" cy="143" rx="8" ry="19" fill={fur} />
      <ellipse cx="60" cy="158.5" rx="7.5" ry="5" fill={cream} stroke={stitch} stroke-width="1.2" /><ellipse cx="120" cy="158.5" rx="7.5" ry="5" fill={cream} stroke={stitch} stroke-width="1.2" />
      <rect x="64" y="100" width="52" height="8" rx="4" fill={lav} stroke={lavS} />
      <circle cx="90" cy="110" r="6" fill={sun} stroke={sunS} />
      <path d="M48 58 L34 30 L76 42 Z M132 58 L146 30 L104 42 Z" fill={fur} />
      <ellipse cx="90" cy="66" rx="46" ry="40" {...st} />
      <path d="M78 34 L82 42 M102 34 L98 42 M72 39 L77 46 M108 39 L103 46" stroke={stripe} stroke-width="2.6" stroke-linecap="round" />
      <path d="M90 34 L82 76 L98 76 Z" fill={cream} />
      <ellipse cx="90" cy="84" rx="24" ry="16" fill={cream} />
      <path d="M85 76 L95 76 L90 82 Z" fill={rose} />
      <path d="M66 82 L40 76 M66 88 L40 91 M114 82 L140 76 M114 88 L140 91" stroke={dark} stroke-opacity=".45" stroke-width="1.2" />
      <circle cx="68" cy="62" r="10" fill={white} stroke={stitch} stroke-width=".8" /><circle cx="112" cy="62" r="10" fill={white} stroke={stitch} stroke-width=".8" />
      <circle cx="68" cy="63" r="5" fill={dark} /><circle cx="112" cy="63" r="5" fill={dark} />
      <circle cx="66.7" cy="60.8" r="1.8" fill={white} /><circle cx="110.7" cy="60.8" r="1.8" fill={white} />
      <ellipse cx="90" cy="88.5" rx="4" ry="4.5" fill="none" stroke={dark} stroke-width="1.6" />
      <path d="M30 118 L20 126 M28 134 L18 138 M150 118 L160 126 M152 134 L162 138" stroke={dlav} stroke-width="2" stroke-linecap="round" />
    </g>
  </svg>
  <span class="cat__bubble" data-for="petted">purr. fine.</span>
  <span class="cat__bubble" data-for="dragging">excuse me?!</span>
  <span class="cat__bubble" data-for="dropped">rude.</span>
  <span class="cat__bubble" data-for="audited">approved ✓ you’re welcome</span>
</span>

<style>
  .cat { position: relative; display: block; width: 100%; aspect-ratio: 180 / 240; --swing: 0deg; }
  .cat svg { width: 100%; height: 100%; overflow: visible; transform-origin: 50% 12%; rotate: var(--swing); transition: rotate .25s var(--ease-out); }
  .cat [data-s] { display: none; }
  .cat[data-state='idle'] [data-s~='idle'], .cat[data-state='petted'] [data-s~='petted'], .cat[data-state='dragging'] [data-s~='dragging'],
  .cat[data-state='dropped'] [data-s~='dropped'], .cat[data-state='audited'] [data-s~='audited'] { display: inline; }
  .cat__breath { transform-box: fill-box; transform-origin: 50% 100%; }
  :global(html.motion-ok) .cat[data-state='idle'] .cat__breath { animation: breathe 4s ease-in-out infinite; }
  @keyframes breathe { 50% { transform: scale(1.012, 1.03); } }
  .cat__tail-flick { transform-box: fill-box; transform-origin: 0% 100%; }
  :global(html.motion-ok) .cat[data-state='dropped'] .cat__tail-flick { animation: flick .35s ease-in-out 3 alternate; }
  @keyframes flick { to { transform: rotate(-14deg); } }
  .cat__bubble { position: absolute; left: 70%; top: 6%; display: none; padding: 1px 9px 2px; border: 1.2px solid var(--ink); border-radius: 999px; background: var(--paper); font: 400 clamp(15px, 1.3vw, 20px)/1.2 var(--f-hand); white-space: nowrap; color: var(--ink); pointer-events: none; }
  .cat[data-state='petted'] [data-for='petted'] { display: block; color: var(--dlav); }
  .cat[data-state='dragging'] [data-for='dragging'] { display: block; top: -4%; }
  .cat[data-state='dropped'] [data-for='dropped'] { display: block; color: var(--red); }
  .cat[data-state='audited'] [data-for='audited'] { display: block; color: var(--henna); left: 40%; top: -2%; }
  :global(html.motion-ok) .cat__bubble { animation: bub .35s var(--ease-spring); }
  @keyframes bub { from { transform: scale(.4) translateY(10px); opacity: 0; } }
  .cat--mini .cat__bubble { font-size: 15px; left: auto; right: 82%; top: 0; }
</style>
