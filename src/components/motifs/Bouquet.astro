---
import SprigGroup from './SprigGroup.astro';
interface Props { class?: string }
const { class: cls = '' } = Astro.props;
const angles = [-18.3, 0, 18.3];
---
<svg class={`motif bouquet ${cls}`} viewBox="0 0 240 280" aria-hidden="true" focusable="false">
  {angles.map((a, i) => (
    <g class="bouquet__stem" style={`--i:${i}`}>
      <SprigGroup transform={`translate(120 260) rotate(${a}) translate(-45 -225)`} />
    </g>
  ))}
  <rect x="107" y="226" width="26" height="9" rx="4" fill="#F5B82E" stroke="#B5821A" />
</svg>
