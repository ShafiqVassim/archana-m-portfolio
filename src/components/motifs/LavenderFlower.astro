---
interface Props { class?: string }
const { class: cls = '' } = Astro.props;
const r = (n: number) => Math.round(n * 100) / 100;
const pts = Array.from({ length: 5 }, (_, i) => {
  const a = (i * Math.PI * 2) / 5 - Math.PI / 2;
  return [r(50 + Math.cos(a) * 18.6), r(50 + Math.sin(a) * 18.6)];
});
---
<svg class={`motif lavender-flower ${cls}`} viewBox="0 0 100 100" aria-hidden="true" focusable="false">
  {pts.map(([x, y]) => <circle cx={x} cy={y} r="15.5" fill="#B9A6E0" stroke="#7E6AAE" stroke-width="1.2" stroke-dasharray="2 3" />)}
  <circle cx="50" cy="50" r="9.6" fill="#F5B82E" stroke="#B5821A" stroke-width="1.2" stroke-dasharray="2 3" />
</svg>
